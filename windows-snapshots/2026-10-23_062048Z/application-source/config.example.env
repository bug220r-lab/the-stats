# Examples only; set environment variables in PowerShell or a service manager.
# Relative paths resolve against the project folder. .env files are NOT auto-loaded.
STATS_MODE=local
STATS_PORT=8501
# STATS_DATA_DIR=<absolute path to private local data directory>
# STATS_IMPORT_DIR=<absolute path to a folder of exports>
# Hosted mode additionally requires durable storage and provider secrets:
# STATS_APPROVED_USERS_FILE=<absolute path to approved_users.json>
# STATS_EXPECTED_ISSUER=https://<your-provider-issuer>
